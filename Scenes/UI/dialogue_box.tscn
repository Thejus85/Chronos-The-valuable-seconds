grow_vertical = 0

theme_override_styles/panel = SubResource("StyleBoxFlat_panel")



[node name="SpeakerLabel" type="Label" parent="Panel"]

layout_mode = 0

offset_left = 24.0

offset_top = 12.0

offset_right = 704.0

offset_bottom = 36.0

