theme_override_font_sizes/font_size = 16

text = "DR. ARIS - TEMPORAL PHYSICIST"



[node name="DialogueText" type="RichTextLabel" parent="Panel"]

layout_mode = 0

offset_left = 24.0

offset_top = 40.0

offset_right = 704.0

offset_bottom = 110.0

theme_override_font_sizes/normal_font_size = 14
theme_override_colors/default_color = Color(0.25, 0.22, 0.16, 1)

bbcode_enabled = true

text = "[color=#3f3424]You are time-slipping. The Chronal Loom is pulling the 2146 ruins into our present. Find the four stabilizers and return to the Nexus.[/color]"



[node name="PromptLabel" type="Label" parent="Panel"]

